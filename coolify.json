{
  "version": "1.0",
  "name": "JS Barbershop",
  "description": "Sistema de gestión de barbería y estilismo",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "port": 81,
    "healthcheck": {
      "path": "/health",
      "interval": 30,
      "timeout": 10,
      "retries": 3,
      "start_period": 40
    }
  },
  "volumes": [
    {
      "source": "barberking_db",
      "target": "/app/instance"
    },
    {
      "source": "barberking_uploads",
      "target": "/app/app/static/uploads"
    }
  ],
  "env": {
    "FLASK_ENV": "production",
    "SECRET_KEY": "change-this-to-a-secure-random-key-in-production",
    "DATABASE_URL": "sqlite:///barberking.db",
    "GUNICORN_WORKER_ID": "0"
  }
}
