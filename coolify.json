{
  "version": "1.0",
  "name": "BarberKing",
  "description": "Sistema de gestión de barbería",
  "services": [
    {
      "name": "barberking_web",
      "build": ".",
      "ports": ["81:81"],
      "command": "gunicorn --bind 0.0.0.0:81 --workers 4 --threads 2 --timeout 60 run:app"
    },
    {
      "name": "barberking_nginx",
      "image": "nginx:alpine",
      "ports": ["80:80"],
      "volumes": ["./nginx.conf:/etc/nginx/conf.d/default.conf:ro"],
      "depends_on": ["barberking_web"]
    }
  ]
}
