# ====================================================================
# EJEMPLO DE VARIABLES DE ENTORNO
# ====================================================================
# Para usar:
# 1. En local: Copia este archivo a .env.local y ajusta los valores
# 2. En producción (Coolify): Usa el panel para establecer estas variables
# 3. NO HAGAS COMMIT de .env - Solo de .env.example

# ====================================================================
# FLASK & APP
# ====================================================================
# development o production
FLASK_ENV=production
FLASK_APP=run.py
# ⚠️ Genera una clave segura: python -c "import secrets; print(secrets.token_hex(32))"
# NUNCA uses el valor de ejemplo en producción
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA_DE_64_CARACTERES

# ====================================================================
# DATABASE - PostgreSQL
# ====================================================================
# Usuario de PostgreSQL
POSTGRES_USER=barber_user
# ⚠️ Contraseña fuerte (mínimo 16 caracteres)
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE
# Nombre de la base de datos
POSTGRES_DB=barberking_db
# Host (en Docker: postgres-db, en local: localhost)
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
# URL de conexión (se construye automáticamente)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ====================================================================
# EVOLUTION API - WhatsApp
# ====================================================================
# URL del API Evolution
EVOLUTION_API_URL=http://evolution_api:8080
# ⚠️ Clave API (mínimo 32 caracteres)
EVOLUTION_API_KEY=CAMBIAR_POR_UNA_CLAVE_API_SEGURA
# Host de base de datos para Evolution
EVOLUTION_DB_HOST=postgres-db
EVOLUTION_DB_PORT=5432
EVOLUTION_DB_USER=barber_user
EVOLUTION_DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_FUERTE
EVOLUTION_DB_NAME=evolution_db
# ⚠️ URL pública de tu servidor (sin http://)
EVOLUTION_SERVER_URL=https://tu-dominio-aqui.com

# ====================================================================
# REDIS
# ====================================================================
# Host de Redis (en Docker: redis, en local: localhost)
REDIS_HOST=redis
REDIS_PORT=6379
# Prefijo para las claves de Redis
REDIS_PREFIX=barber

# ====================================================================
# APP CONFIG
# ====================================================================
# Zona horaria
TZ=America/Bogota
# Tamaño máximo de uploads (5MB = 5242880 bytes)
MAX_CONTENT_LENGTH=5242880
# Storage para rate limiting (memory:// para desarrollo)
RATELIMIT_STORAGE_URI=memory://


